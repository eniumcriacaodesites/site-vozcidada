---
import Logo from '@/components/ui/Logo.astro';
import { site } from '@/lib/site';

/** Rodapé institucional (dados da empresa pendentes ficam ocultos). */
const year = new Date().getFullYear();
const legal = [
    site.company.legalName,
    site.company.cnpj && `CNPJ ${site.company.cnpj}`,
]
    .filter(Boolean)
    .join(' · ');
---

<footer class="bg-[#031a36] text-white/75" data-theme="dark">
    <div class="container-site grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
        <div class="flex flex-col gap-4">
            <Logo
                class="text-white"
                markClass="h-9 w-auto"
                textClass="text-[1.3rem]"
            />
            <p class="max-w-[32ch] text-sm">
                O cidadão fala. A prefeitura resolve. A cidade vê.
            </p>
            <p class="text-sm">
                Um produto
                <a
                    class="font-bold text-white hover:underline"
                    href={site.company.url}
                    target="_blank"
                    rel="noopener"
                >
                    {site.company.name}
                </a>
            </p>
        </div>
        <nav aria-label="Produto" class="text-sm">
            <p class="mb-3 font-bold text-white">Produto</p>
            <ul class="flex flex-col gap-2">
                <li>
                    <a class="hover:text-white" href="/#como-funciona">
                        Como funciona
                    </a>
                </li>
                <li>
                    <a class="hover:text-white" href="/#ia">
                        Inteligência artificial
                    </a>
                </li>
                <li>
                    <a class="hover:text-white" href="/#painel">
                        Painel do gestor
                    </a>
                </li>
                <li>
                    <a class="hover:text-white" href="/#seguranca">
                        Segurança
                    </a>
                </li>
            </ul>
        </nav>
        <nav aria-label="Materiais" class="text-sm">
            <p class="mb-3 font-bold text-white">Materiais</p>
            <ul class="flex flex-col gap-2">
                <li>
                    <a
                        class="hover:text-white"
                        href="/apresentacao"
                        data-track="presentation_start:rodape"
                    >
                        Modo apresentação
                    </a>
                </li>
                <li>
                    <a
                        class="hover:text-white"
                        href={site.deckPdfPath}
                        data-track="pdf_download:rodape"
                    >
                        Baixar apresentação (PDF)
                    </a>
                </li>
                <li>
                    <a
                        class="hover:text-white"
                        href={site.googlePlayUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        App na Google Play
                    </a>
                </li>
            </ul>
        </nav>
        <nav aria-label="Institucional" class="text-sm">
            <p class="mb-3 font-bold text-white">Institucional</p>
            <ul class="flex flex-col gap-2">
                <li>
                    <a class="hover:text-white" href="/privacidade">
                        Política de privacidade
                    </a>
                </li>
                <li>
                    <a class="hover:text-white" href="/#contato">
                        Agendar demonstração
                    </a>
                </li>
                <li>
                    <a
                        class="hover:text-white"
                        href={site.company.url}
                        target="_blank"
                        rel="noopener"
                    >
                        Conheça outros serviços da Enium
                    </a>
                </li>
            </ul>
        </nav>
    </div>
    <div class="border-t border-white/10">
        <div class="container-site flex flex-col gap-2 py-6 text-xs sm:flex-row sm:justify-between">
            <p>
                © {year} {site.company.name} · VozCidadã{legal && ` · ${legal}`}
            </p>
            <p>Acessível em Libras com o VLibras.</p>
        </div>
    </div>
</footer>
