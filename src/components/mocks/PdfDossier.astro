---
import StreetScene from '@/components/art/StreetScene.astro';

import HeatMap from './HeatMap.astro';

/** Dossiê em PDF da demanda (identificação, mapa, fotos, linha do tempo). */
interface Props {
    class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
    class:list={[
        'aspect-[1/1.32] w-full space-y-2 rounded-md bg-white p-3 text-[0.55rem] text-text shadow-lift ring-1 ring-line',
        className,
    ]}
    aria-hidden="true"
>
    <div class="flex items-center justify-between border-b border-line pb-1.5">
        <b class="text-[0.7rem]">Dossiê · Demanda #0042</b>
        <span class="rounded bg-navy-900 px-1 font-bold text-white">PDF</span>
    </div>
    <div class="h-14 overflow-hidden rounded">
        <HeatMap />
    </div>
    <div class="grid grid-cols-2 gap-1">
        <div class="h-12 overflow-hidden rounded">
            <StreetScene state="before" />
        </div>
        <div class="h-12 overflow-hidden rounded">
            <StreetScene state="after" />
        </div>
    </div>
    <div class="space-y-1">
        {[80, 92, 70, 86, 60].map((w) => (
            <i class="block h-1 rounded-full bg-line" style={`width:${w}%`} />
        ))}
    </div>
</div>
