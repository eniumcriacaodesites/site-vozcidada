---
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/lib/icons';

/**
 * Cidade em camadas para o conceito "a cidade amanhece".
 * - dusk (capa): entardecer, janelas acesas e pinos LARANJA (problemas).
 * - dawn (CTA final): amanhecer, sol nascendo e pinos VERDES (resolvidos).
 *
 * As silhuetas são geradas de forma determinística (semente fixa), então o
 * HTML é idêntico a cada build. Cada camada tem `data-depth` para o parallax.
 */
interface Props {
    time?: 'dusk' | 'dawn';
    class?: string;
}

const { time = 'dusk', class: className = '' } = Astro.props;

const W = 1600;
const BASE = 560;

function seeded(seed: number): () => number {
    let s = seed;
    return () => {
        s = (s + 0x6d2b79f5) | 0;
        let t = Math.imul(s ^ (s >>> 15), 1 | s);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
}

interface Tower {
    x: number;
    w: number;
    h: number;
}

function towers(
    seed: number,
    minW: number,
    maxW: number,
    minH: number,
    maxH: number,
): Tower[] {
    const rand = seeded(seed);
    const list: Tower[] = [];
    let x = -30;
    while (x < W + 30) {
        const w = minW + rand() * (maxW - minW);
        const h = minH + rand() * (maxH - minH);
        list.push({ x, w, h });
        x += w + rand() * 8;
    }
    return list;
}

const toPath = (list: Tower[]) =>
    list
        .map(
            (t) =>
                `M${t.x.toFixed(1)} ${BASE}V${(BASE - t.h).toFixed(1)}H${(t.x + t.w).toFixed(1)}V${BASE}Z`,
        )
        .join('');

const far = towers(7, 40, 95, 150, 300);
const mid = towers(21, 55, 120, 90, 230);

// Janelas acesas nos prédios do meio (só algumas, para dar vida).
const winRand = seeded(99);
const windows: { x: number; y: number }[] = [];
for (const t of mid) {
    const cols = Math.max(1, Math.floor((t.w - 14) / 16));
    const rows = Math.max(1, Math.floor((t.h - 20) / 22));
    for (let c = 0; c < cols; c++) {
        for (let r = 0; r < rows; r++) {
            if (winRand() < (time === 'dusk' ? 0.28 : 0.1)) {
                windows.push({
                    x: t.x + 9 + c * 16,
                    y: BASE - t.h + 12 + r * 22,
                });
            }
        }
    }
}

// Casario baixo + igreja matriz (toque de cidade do interior).
const houseRand = seeded(314);
const houses: string[] = [];
let hx = -20;
while (hx < W + 20) {
    const w = 70 + houseRand() * 60;
    const h = 46 + houseRand() * 34;
    const roof = 22 + houseRand() * 14;
    if (hx > 700 && hx < 900) {
        hx = 905;
        continue;
    }
    houses.push(
        `M${hx.toFixed(1)} ${BASE}V${(BASE - h).toFixed(1)}L${(hx + w / 2).toFixed(1)} ${(BASE - h - roof).toFixed(1)}L${(hx + w).toFixed(1)} ${(BASE - h).toFixed(1)}V${BASE}Z`,
    );
    hx += w + 4 + houseRand() * 18;
}
const church =
    'M735 560V452H770V330L790 296L810 330V452H865V560Z' +
    'M786 270H794V284H802V292H794V300H786V292H778V284H786Z';

const palette = {
    dusk: {
        far: '#133760',
        mid: '#0c2a4d',
        near: '#05254d',
        street: '#03182f',
        window: '#f2c230',
    },
    dawn: {
        far: '#2b5a92',
        mid: '#1d4677',
        near: '#133760',
        street: '#0c2a4d',
        window: '#f6a77c',
    },
}[time];

interface Pin {
    left: string;
    bottom: string;
    depth: string;
    icon: IconName;
    delay: string;
}

const pins: Pin[] =
    time === 'dusk'
        ? [
              {
                  left: '9%',
                  bottom: '34%',
                  depth: '0.18',
                  icon: 'lightbulb',
                  delay: '0s',
              },
              {
                  left: '31%',
                  bottom: '24%',
                  depth: '0.3',
                  icon: 'construction',
                  delay: '.6s',
              },
              {
                  left: '57%',
                  bottom: '38%',
                  depth: '0.14',
                  icon: 'trash-2',
                  delay: '1.1s',
              },
              {
                  left: '88%',
                  bottom: '26%',
                  depth: '0.34',
                  icon: 'tree-deciduous',
                  delay: '.3s',
              },
          ]
        : [
              {
                  left: '9%',
                  bottom: '32%',
                  depth: '0.18',
                  icon: 'check',
                  delay: '0s',
              },
              {
                  left: '31%',
                  bottom: '24%',
                  depth: '0.3',
                  icon: 'check',
                  delay: '.5s',
              },
              {
                  left: '61%',
                  bottom: '36%',
                  depth: '0.14',
                  icon: 'check',
                  delay: '1s',
              },
              {
                  left: '88%',
                  bottom: '26%',
                  depth: '0.34',
                  icon: 'check',
                  delay: '.2s',
              },
          ];
---

<div
    class:list={['pointer-events-none absolute inset-x-0 bottom-0', className]}
    aria-hidden="true"
    data-city={time}
>
    {time === 'dawn' && (
        <div
            class="absolute bottom-[18%] left-1/2 size-[clamp(8rem,22cqi,18rem)] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,#ffe7a3_0%,#f6a77c_45%,transparent_70%)] opacity-90 blur-[2px]"
            data-depth="0.08"
            data-sun
        />
    )}
    <svg
        class="absolute inset-x-0 bottom-0 h-full w-full"
        viewBox={`0 0 ${W} 600`}
        preserveAspectRatio="xMidYMax slice"
        data-depth="0.1"
    >
        <path d={toPath(far)} fill={palette.far} opacity="0.85"></path>
    </svg>
    <svg
        class="absolute inset-x-0 bottom-0 h-full w-full"
        viewBox={`0 0 ${W} 600`}
        preserveAspectRatio="xMidYMax slice"
        data-depth="0.2"
    >
        <path d={toPath(mid)} fill={palette.mid}></path>
        <g fill={palette.window} opacity="0.85">
            {windows.map((w) => (
                <rect
                    x={w.x.toFixed(1)}
                    y={w.y.toFixed(1)}
                    width="7"
                    height="10"
                    rx="1"
                />
            ))}
        </g>
    </svg>
    <svg
        class="absolute inset-x-0 bottom-0 h-full w-full"
        viewBox={`0 0 ${W} 600`}
        preserveAspectRatio="xMidYMax slice"
        data-depth="0.32"
    >
        <path d={houses.join('')} fill={palette.near}></path>
        <path d={church} fill={palette.near}></path>
        <circle
            cx="800"
            cy="372"
            r="10"
            fill={palette.window}
            opacity="0.9"
        ></circle>
        <g fill={palette.near}>
            <path d="M210 560c6-40 4-70-4-104l6-2c10 34 12 66 6 106Z"></path>
            <path d="M206 458c-26-6-44 2-58 16 18-4 36-6 56-2-20 2-38 12-50 26 20-8 40-14 58-14-8 10-14 24-16 38 10-12 22-22 34-28 6 14 16 24 28 32-2-14-8-28-18-38 20 0 36 8 52 18-10-16-26-26-46-30 20-6 40-4 60 2-16-14-38-20-62-16Z"></path>
            <path d="M1370 560c4-34 2-62-6-92l6-2c10 30 12 58 6 94Z"></path>
            <path d="M1366 470c-24-6-40 2-54 14 16-4 34-6 52-2-18 2-34 10-46 24 18-8 36-12 52-12-6 10-12 22-14 34 10-10 20-20 32-26 6 12 14 22 26 30-2-14-8-26-16-36 18 0 34 8 48 16-10-14-24-24-42-28 18-6 36-4 54 2-14-12-34-18-56-14Z"></path>
        </g>
    </svg>
    <svg
        class="absolute inset-x-0 bottom-0 h-[16%] w-full"
        viewBox="0 0 1600 96"
        preserveAspectRatio="none"
        data-depth="0.42"
    >
        <rect y="0" width="1600" height="96" fill={palette.street}></rect>
        <path
            d="M0 52H1600"
            stroke={time === 'dusk' ? '#f2c230' : '#f6a77c'}
            stroke-width="5"
            stroke-dasharray="46 34"
            opacity="0.55"
        ></path>
    </svg>

    {pins.map((pin) => (
        <div
            class="absolute"
            style={`left:${pin.left};bottom:${pin.bottom}`}
            data-depth={pin.depth}
            data-pin
        >
            <div class="animate-float" style={`animation-delay:${pin.delay}`}>
                <span
                    class:list={[
                        'relative flex size-[clamp(2.25rem,3.4cqi,3rem)] items-center justify-center rounded-full ring-4 shadow-lg',
                        time === 'dusk'
                            ? 'bg-orange-500 text-navy-950 ring-orange-500/25'
                            : 'bg-green-500 text-white ring-green-500/25',
                    ]}
                >
                    <Icon
                        name={pin.icon}
                        class="size-[45%]"
                        strokeWidth={2.5}
                    />
                    <span
                        class:list={[
                            'absolute -bottom-1.5 left-1/2 size-3 -translate-x-1/2 rotate-45 rounded-[2px]',
                            time === 'dusk' ? 'bg-orange-500' : 'bg-green-500',
                        ]}
                    />
                </span>
            </div>
        </div>
    ))}
</div>
