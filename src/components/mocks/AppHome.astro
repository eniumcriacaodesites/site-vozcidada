---
import StreetScene from '@/components/art/StreetScene.astro';
import Icon from '@/components/ui/Icon.astro';
import LogoMark from '@/components/ui/LogoMark.astro';

import AppStatusBar from './AppStatusBar.astro';
import AppTabBar from './AppTabBar.astro';

/** Tela inicial do app (fiel a vozcidada-app/src/app/(tabs)/inicio.tsx). */
---

<div class="relative flex h-full flex-col bg-paper">
    <div class="bg-navy-900">
        <AppStatusBar />
        <div class="flex items-center gap-2 px-4 pt-1 pb-3 text-white">
            <LogoMark class="h-6 w-auto text-white" />
            <span class="text-[0.95rem] font-extrabold tracking-tight">
                VozCidadã
            </span>
        </div>
    </div>
    <div class="flex-1 space-y-2.5 overflow-hidden px-3 pt-3">
        <div class="space-y-1.5 rounded-2xl bg-[linear-gradient(135deg,#1d4677,#0c2a4d)] p-3.5 text-white">
            <p class="text-[1rem] font-extrabold">Olá, Maria!</p>
            <p class="text-[0.72rem] text-white/85">
                Viu um problema na cidade? Fotografe e relate em poucos passos.
            </p>
            <span class="mt-1 flex h-9 items-center justify-center gap-1.5 rounded-xl bg-orange-500 text-[0.75rem] font-bold text-white">
                <Icon name="camera" class="size-4" />
                Relatar um problema
            </span>
        </div>
        <div class="overflow-hidden rounded-2xl bg-white ring-1 ring-line">
            <div class="grid h-20 grid-cols-2 gap-px bg-line">
                <StreetScene state="before" />
                <StreetScene state="after" />
            </div>
            <div class="space-y-1 p-2.5">
                <p class="flex items-center gap-1 text-[0.62rem] font-bold text-success">
                    <Icon name="circle-check" class="size-3" /> Obra concluída ·
                    Buracos
                </p>
                <p class="text-[0.72rem] font-bold">Rua das Flores, Centro</p>
            </div>
        </div>
        <div class="rounded-2xl bg-white p-2.5 ring-1 ring-line">
            <p class="text-[0.6rem] font-bold text-orange-700 uppercase">
                Comunicado
            </p>
            <p class="text-[0.72rem] font-bold">Mutirão de limpeza no sábado</p>
        </div>
    </div>
    <AppTabBar />
</div>
