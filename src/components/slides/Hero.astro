---
import CityScape from '@/components/art/CityScape.astro';
import AppHome from '@/components/mocks/AppHome.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import PhoneFrame from '@/components/ui/PhoneFrame.astro';
import { slideAnchor, type Slide } from '@/lib/slides';

import SlideSection from './SlideSection.astro';

/** S01 · Capa — "a cidade ao anoitecer" com os pinos laranja (problemas). */
interface Props {
    slide: Slide;
    mode?: 'web' | 'deck';
}

const { slide, mode = 'web' } = Astro.props;
const { kicker, title, lead, badges } = slide.data;
const anchor = slideAnchor(slide.id);

// Uma frase por linha; a última ("A cidade vê.") em destaque.
const sentences = title.split(/(?<=\.)\s+/);

const chips = [
    {
        icon: 'circle-check',
        text: 'Protocolo #0042 criado',
        pos: 'top-[44%] -left-48',
    },
    {
        icon: 'sparkles',
        text: 'IA: local da foto confere',
        pos: 'top-[30%] -right-36',
    },
    { icon: 'hard-hat', text: 'Equipe a caminho', pos: 'top-[70%] -left-40' },
] as const;
---

<SlideSection slide={slide} class="grain min-h-svh" scene="hero">
    <Fragment slot="bg">
        <div
            class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#041c3b_0%,#0c2a4d_42%,#1d4677_74%,#3b5683_100%)]"
            aria-hidden="true"
            data-sky
        ></div>
        <div
            class="absolute inset-x-0 bottom-[8%] -z-10 h-[50%] bg-[radial-gradient(ellipse_at_50%_100%,rgb(240_125_63/0.42),transparent_62%)]"
            aria-hidden="true"
            data-depth="0.05"
        ></div>
        <div
            class="absolute inset-0 -z-10 bg-[radial-gradient(1px_1px_at_12%_18%,#fff_50%,transparent_51%),radial-gradient(1px_1px_at_32%_8%,#fff_50%,transparent_51%),radial-gradient(1.5px_1.5px_at_58%_14%,#fff_50%,transparent_51%),radial-gradient(1px_1px_at_76%_22%,#fff_50%,transparent_51%),radial-gradient(1px_1px_at_90%_10%,#fff_50%,transparent_51%),radial-gradient(1px_1px_at_44%_26%,#fff_50%,transparent_51%)] opacity-60"
            aria-hidden="true"
            data-depth="0.03"
        ></div>
        <CityScape time="dusk" class="h-[30%] lg:h-[34%]" />
    </Fragment>

    <div class="container-site relative z-10 grid items-center gap-14 pt-10 pb-[24cqi] @5xl:grid-cols-[1.08fr_0.92fr] @5xl:pb-[13cqi]">
        <div class="flex flex-col gap-6">
            <p class="kicker animate-rise">{kicker}</p>
            <h1
                id={`${anchor}-title`}
                class="text-display font-extrabold text-white animate-rise [animation-delay:.08s]"
            >
                {sentences.map((sentence, index) => (
                    <span
                        class:list={[
                            'block',
                            index === sentences.length - 1 &&
                                'bg-[linear-gradient(90deg,#F07D3F,#F2C230)] bg-clip-text text-transparent',
                        ]}
                    >
                        {sentence}
                    </span>
                ))}
            </h1>
            <p class="text-lead max-w-[48ch] text-white/80 animate-rise [animation-delay:.16s]">
                {lead}
            </p>
            {mode === 'web' && (
                <div class="flex flex-wrap items-center gap-3 animate-rise [animation-delay:.24s]">
                    <Button
                        href="#contato"
                        size="lg"
                        track="cta_click:hero"
                        magnetic
                    >
                        Agendar demonstração
                        <Icon
                            name="arrow-right"
                            class="size-5 transition-transform group-hover/btn:translate-x-1"
                        />
                    </Button>
                    <Button
                        href="/apresentacao"
                        variant="secondary"
                        size="lg"
                        track="presentation_start:hero"
                    >
                        <Icon name="play" class="size-4" />
                        Ver a apresentação
                    </Button>
                </div>
            )}
            <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-white/80 animate-rise [animation-delay:.32s]">
                {badges.map((badge) => (
                    <li class="flex items-center gap-1.5">
                        <Icon
                            name="badge-check"
                            class="size-4 text-orange-500"
                        />
                        {badge}
                    </li>
                ))}
            </ul>
        </div>

        <div
            class="relative mx-auto w-fit animate-rise [animation-delay:.2s]"
            data-hero-phone
        >
            <svg
                class="absolute top-[22%] left-[78%] h-[48%] w-auto text-orange-500"
                viewBox="580 210 280 440"
                fill="none"
                stroke="currentColor"
                stroke-width="34"
                stroke-linecap="round"
                aria-hidden="true"
            >
                <g class="animate-voice">
                    <path d="M602 342A100 100 0 0 1 602 518"></path>
                    <path d="M649 279A178 178 0 0 1 649 581"></path>
                    <path d="M710 224A258 258 0 0 1 721 628"></path>
                </g>
            </svg>
            <PhoneFrame
                class="w-[min(17rem,64cqi)] @5xl:w-[min(19rem,26cqi)]"
                label="Tela inicial do app VozCidadã com o botão Relatar um problema"
            >
                <AppHome />
            </PhoneFrame>
            {chips.map((chip, index) => (
                <div
                    class:list={[
                        'absolute hidden items-center gap-2 rounded-2xl bg-navy-900/95 px-3.5 py-2.5 text-sm font-bold whitespace-nowrap text-white shadow-lift ring-1 ring-white/15 backdrop-blur @5xl:flex',
                        chip.pos,
                    ]}
                    data-depth={String(0.12 + index * 0.06)}
                    data-chip
                    aria-hidden="true"
                >
                    <span class="flex size-7 items-center justify-center rounded-full bg-orange-500 text-navy-950">
                        <Icon name={chip.icon} class="size-4" />
                    </span>
                    {chip.text}
                </div>
            ))}
        </div>
    </div>

    {mode === 'web' && (
        <a
            slot="bg"
            href="#problema"
            class="absolute bottom-6 left-1/2 z-10 hidden -translate-x-1/2 flex-col items-center gap-1 text-xs font-semibold text-white/75 transition-colors hover:text-white lg:flex"
            aria-label="Rolar para o próximo slide"
        >
            Role para começar
            <Icon name="chevron-down" class="size-5 animate-float" />
        </a>
    )}
</SlideSection>
