{
    "name": "site-vozcidada",
    "description": "Site comercial do VozCidadã — landing em slides + modo apresentação",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.23.4"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "cf-typegen": "wrangler types",
        "check": "wrangler types && astro check && vue-tsc --noEmit -p tsconfig.vue.json",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "ibge": "node scripts/build-ibge-municipios.mjs",
        "icons": "node scripts/generate-icons.mjs",
        "assets:export": "node scripts/export-assets.mjs"
    },
    "dependencies": {
        "@astrojs/cloudflare": "14.4.7",
        "@astrojs/sitemap": "3.7.4",
        "@astrojs/vue": "7.1.4",
        "@fontsource-variable/plus-jakarta-sans": "5.3.0",
        "@tailwindcss/vite": "4.3.5",
        "astro": "7.4.10",
        "gsap": "3.15.1",
        "lenis": "1.3.27",
        "tailwindcss": "4.3.5",
        "vue": "3.5.45"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.12",
        "@axe-core/playwright": "4.14.0",
        "@playwright/test": "1.65.0",
        "@types/qrcode": "1.5.6",
        "eslint": "10.14.0",
        "eslint-plugin-astro": "3.2.1",
        "eslint-plugin-vue": "10.12.1",
        "globals": "17.14.0",
        "lucide-static": "1.72.0",
        "prettier": "3.10.0",
        "prettier-plugin-astro": "1.1.2",
        "prettier-plugin-tailwindcss": "0.8.1",
        "qrcode": "1.5.4",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.2",
        "vitest": "5.1.0",
        "vue-tsc": "3.3.14",
        "wrangler": "4.160.0"
    }
}
