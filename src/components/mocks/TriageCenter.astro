---
import StreetScene from '@/components/art/StreetScene.astro';
import Icon from '@/components/ui/Icon.astro';

import HeatMap from './HeatMap.astro';

/** Centro de Triagem: fila priorizada, mapa (pinos/calor/área) e detalhe. */
const queue = [
    {
        id: '#0042',
        title: 'Buraco na via',
        where: 'Centro',
        stars: 4,
        score: 87,
        dup: 9,
    },
    {
        id: '#0047',
        title: 'Poste apagado',
        where: 'São José',
        stars: 3,
        score: 81,
        dup: 2,
    },
    {
        id: '#0049',
        title: 'Lixo acumulado',
        where: 'Centro',
        stars: 3,
        score: 74,
        dup: 0,
    },
    {
        id: '#0051',
        title: 'Galho caído',
        where: 'Alto',
        stars: 2,
        score: 58,
        dup: 0,
    },
];
---

<div class="grid min-h-[22rem] grid-cols-[1.05fr_1.25fr_1fr] text-[0.72rem]">
    <div class="space-y-2 border-r border-line bg-white p-3" data-spot="fila">
        <p class="flex items-center justify-between font-extrabold">
            Triagem{' '}
            <span class="rounded-full bg-orange-100 px-2 py-0.5 text-[0.62rem] text-orange-700">
                14 novas
            </span>
        </p>
        <div class="flex gap-1 text-[0.6rem] font-bold text-muted">
            <span class="rounded-md bg-navy-900 px-1.5 py-0.5 text-white">
                Prioridade
            </span>
            <span class="rounded-md bg-paper px-1.5 py-0.5">Recentes</span>
        </div>
        <ul class="space-y-1.5">
            {queue.map((row, index) => (
                <li
                    class:list={[
                        'space-y-0.5 rounded-lg p-2 ring-1',
                        index === 0
                            ? 'bg-navy-100 ring-navy-700/30'
                            : 'bg-white ring-line',
                    ]}
                >
                    <p class="flex justify-between font-bold">
                        <span>
                            {row.id} {row.title}
                        </span>
                    </p>
                    <p class="flex items-center justify-between text-[0.62rem] text-muted">
                        <span>
                            {row.where} ·{' '}
                            <span class="text-orange-700">
                                {'★'.repeat(row.stars)}
                                {'☆'.repeat(5 - row.stars)}
                            </span>
                        </span>
                        <span class="flex items-center gap-1">
                            {row.dup > 0 && (
                                <span class="rounded bg-white px-1 font-bold text-navy-900 ring-1 ring-line">
                                    +{row.dup}
                                </span>
                            )}
                            <b
                                class:list={[
                                    'tabular rounded px-1',
                                    row.score >= 65
                                        ? 'bg-[#e6f6ec] text-success'
                                        : 'bg-[#fef3e2] text-[#b45309]',
                                ]}
                            >
                                {row.score}
                            </b>
                        </span>
                    </p>
                </li>
            ))}
        </ul>
    </div>
    <div class="relative bg-[#eef2f6]" data-spot="mapa">
        <HeatMap polygon />
        <span class="absolute top-2 left-2 flex items-center gap-1 rounded-md bg-white px-2 py-1 text-[0.6rem] font-bold shadow-sm">
            <Icon name="map" class="size-3" /> Calor · Pinos · Área
        </span>
    </div>
    <div class="space-y-2 bg-white p-3" data-spot="detalhe">
        <div class="h-20 overflow-hidden rounded-lg">
            <StreetScene state="before" />
        </div>
        <p class="font-extrabold">#0042 · Buraco na via</p>
        <p class="text-[0.62rem] text-muted">
            Resumo da IA: via de acesso a escola, risco para pedestres.
        </p>
        <p class="flex flex-wrap gap-1 text-[0.58rem] font-bold">
            <span class="rounded bg-[#e6f6ec] px-1.5 py-0.5 text-success">
                Local confere
            </span>
            <span class="rounded bg-[#e6f6ec] px-1.5 py-0.5 text-success">
                Foto original
            </span>
            <span class="rounded bg-navy-100 px-1.5 py-0.5 text-navy-900">
                +9 reforços
            </span>
        </p>
        <span class="flex h-8 items-center justify-center rounded-lg bg-navy-900 text-[0.68rem] font-bold text-white">
            Aprovar grupo (10)
        </span>
        <span class="flex h-8 items-center justify-center rounded-lg text-[0.68rem] font-bold ring-1 ring-line">
            Rejeitar com motivo
        </span>
    </div>
</div>
