---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { slideAnchor, type Slide } from '@/lib/slides';

import SlideSection from './SlideSection.astro';

/** S16 · Perguntas frequentes — <details> nativo (acessível, sem JS). */
interface Props {
    slide: Slide;
    mode?: 'web' | 'deck';
}

const { slide, mode = 'web' } = Astro.props;
const { kicker, title, faq } = slide.data;
const anchor = slideAnchor(slide.id);
---

<SlideSection slide={slide}>
    <div
        class:list={[
            'container-site grid gap-12',
            mode === 'web' ? '@5xl:grid-cols-[0.8fr_1.2fr]' : 'gap-10',
        ]}
    >
        <div class="flex flex-col gap-8">
            <SectionHeader
                kicker={kicker}
                title={title}
                id={`${anchor}-title`}
            />
            {mode === 'web' && (
                <div class="flex flex-wrap gap-3" data-reveal>
                    <Button href="#contato" track="cta_click:faq">
                        Agendar demonstração
                        <Icon name="arrow-right" class="size-4" />
                    </Button>
                </div>
            )}
        </div>
        <div
            class:list={[
                mode === 'web'
                    ? 'flex flex-col gap-3'
                    : 'grid grid-cols-2 gap-3',
            ]}
        >
            {faq.map((entry) => (
                <details class="group/faq card overflow-hidden" data-reveal>
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-[1.05rem] font-bold text-ink [&::-webkit-details-marker]:hidden">
                        {entry.q}
                        <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-surface-2 text-ink-muted transition-transform duration-300 group-open/faq:rotate-180">
                            <Icon name="chevron-down" class="size-4" />
                        </span>
                    </summary>
                    <p class="px-5 pb-5 leading-relaxed text-ink-muted">
                        {entry.a}
                    </p>
                </details>
            ))}
        </div>
    </div>
</SlideSection>
