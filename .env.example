# Variáveis PÚBLICAS de build (astro:env, contexto client). Não coloque segredos aqui.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Somente dígitos com DDI, ex.: 5579999999999 (vazio = botão de WhatsApp oculto)
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=br.com.vozcidada.app
PUBLIC_UMAMI_WEBSITE_ID=
# Avisos "Pendente de validação" nos slides (true em dev/preview, false em produção)
PUBLIC_SHOW_PENDING=true
# true no build de preview (branch dev) para não indexar
PUBLIC_NOINDEX=false
