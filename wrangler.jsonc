// Worker do site comercial do VozCidadã (assets estáticos + POST /api/lead).
// Segredos NÃO ficam aqui: use `wrangler secret put` (produção) e `.dev.vars` (local).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-vozcidada",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // `main` e o diretório dos assets são definidos pelo @astrojs/cloudflare
  // no build (dist/server/wrangler.json → assets em dist/client).
  "assets": {
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // Limite de envios do formulário por IP (além do Turnstile e do honeypot).
  "ratelimits": [
    {
      "name": "LEAD_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  // Preserva as variáveis cadastradas no painel (LEAD_TO_EMAIL, LEAD_FROM_EMAIL,
  // SHEETS_WEBHOOK_URL) a cada deploy. Não declare essas chaves aqui: o valor
  // deste arquivo sobrescreveria o do painel.
  "keep_vars": true,
  "vars": {
    "LEAD_FROM_EMAIL": "nao-responda@vozcidada.enium.com.br",
    "LEAD_FROM_NAME": "VozCidadã",
    "LEAD_TO_EMAIL": "mateus.barboza22@gmail.com",
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAGB94WqbwY5uIrUj",
    "SHEETS_WEBHOOK_URL": "https://script.google.com/macros/s/AKfycbxZkLUGHXhWgO_1c1N4s0gm-B-Hxf8-NK_A5Su-Lijz-iXSqq__SJLTiAt0jqOH_wnm/exec",
    "SITE_ENV": "production"
  },
}