---
import SiteFooter from '@/components/site/SiteFooter.astro';
import Logo from '@/components/ui/Logo.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

/** Layout das páginas institucionais simples (privacidade, obrigado, 404). */
interface Props {
    title: string;
    description?: string;
    noindex?: boolean;
    path?: string;
}

const { title, description, noindex = false, path } = Astro.props;
---

<BaseLayout
    title={title}
    description={description}
    noindex={noindex}
    path={path}
>
    <a href="#conteudo" class="skip-link">
        Ir para o conteúdo
    </a>
    <header class="bg-navy-950 text-white">
        <div class="container-site flex h-16 items-center">
            <a href="/" aria-label="VozCidadã — início">
                <Logo />
            </a>
        </div>
    </header>
    <main id="conteudo" class="min-h-[60vh] bg-paper py-16">
        <div class="container-site">
            <slot />
        </div>
    </main>
    <SiteFooter />
</BaseLayout>
